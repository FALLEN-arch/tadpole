#!/usr/bin/env python3
import sys
import os

# Ensure we can find the tadpole package
# When installed via pip/meson, it should be in site-packages
# When running from source, add src to path
src_path = os.path.join(os.path.dirname(__file__), '..', 'src')
if os.path.exists(os.path.join(src_path, 'tadpole')):
    sys.path.insert(0, src_path)

from tadpole.application import main
main()
